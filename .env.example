# --- Backend (apps/backend) ---
# Comma-separated list of origins allowed to call the backend.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Which execution backend runs submitted code: "docker" (default, the
# intended secure path — see runner/README.md) or "subprocess" (fallback
# for environments without Docker installed; NOT a security sandbox).
EXECUTION_BACKEND=docker

# Path to the `docker` executable. Rarely needs changing.
DOCKER_BINARY=docker

# Tag of the image built by ./runner/build.sh.
DOCKER_RUNNER_IMAGE=ai-code-breaker-runner:latest

# Resource limits applied to every runner container.
DOCKER_RUNNER_MEMORY_MB=256
DOCKER_RUNNER_CPUS=1.0
DOCKER_RUNNER_PIDS_LIMIT=16

# Database (matches infra/docker-compose.yml). Uses the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://acb:acb@localhost:5432/ai_code_breaker
# Set to true to log all SQL (noisy; useful when debugging).
DATABASE_ECHO=false

# --- Claude / Anthropic (optional: targeted AI test generation) ---
# AI test generation is entirely optional. If ANTHROPIC_API_KEY is unset,
# analysis still works using deterministic + Hypothesis + manual tests;
# requests with use_ai_tests=true simply report the AI as unavailable.
# The key is read from the environment and is NEVER logged.
ANTHROPIC_API_KEY=
# Model name is configured here, not hardcoded.
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_TOKENS=1024
# Max tests a single AI call may contribute (also bounded by MAX_TOTAL_TESTS).
AI_MAX_GENERATED_TESTS=8

# --- Frontend (apps/frontend) ---
# Base URL the browser uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Redis / job queue (async analysis) -------------------------------------
REDIS_URL=redis://localhost:6379/0
ANALYSIS_QUEUE_NAME=analysis
# Run jobs inline instead of via a worker (tests / local debugging). When
# set, no worker or Redis is needed. Leave unset for the real async flow.
# QUEUE_EAGER=1

# Overall wall-clock ceiling for a whole analysis job (seconds).
JOB_TIMEOUT_SECONDS=600
# How long a finished job's result/metadata is retained in Redis.
JOB_RESULT_TTL_SECONDS=86400
# Max retries for TRANSIENT job failures (user-code failures are never
# retried regardless of this value).
JOB_MAX_RETRIES=2

# Per-stage soft timeouts (seconds).
STAGE_TIMEOUT_GENERATING_TESTS=60
STAGE_TIMEOUT_EXECUTING_TESTS=180
STAGE_TIMEOUT_SEARCHING_PROPERTIES=120
STAGE_TIMEOUT_MINIMIZING=120
STAGE_TIMEOUT_EXPLAINING=60

# --- Security / abuse limits ------------------------------------------------
# Max HTTP request body size in bytes (413 over the limit). ~256 KB fits two
# 20k-char source files plus spec and inputs comfortably.
MAX_REQUEST_BODY_BYTES=262144
# Per-client token-bucket rate limit on submission/analysis creation.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=10
RATE_LIMIT_ENABLED=true
# Max in-flight analyses per client, and the anonymous lifetime quota
# (0 disables the quota). Clients may identify with the header below.
MAX_CONCURRENT_ANALYSES_PER_CLIENT=3
ANONYMOUS_ANALYSIS_QUOTA=100
CLIENT_ID_HEADER=X-Client-Id

# --- Observability ----------------------------------------------------------
# Log level (DEBUG/INFO/WARNING/ERROR) and format ('json' for production
# structured logs, 'text' for human-readable development output).
LOG_LEVEL=INFO
LOG_FORMAT=text
